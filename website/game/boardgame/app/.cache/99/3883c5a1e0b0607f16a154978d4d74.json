G.cells.filter((c) => c === null).length == 0) {\n      return { draw: true };\n    }\n  },\n\n  ai: {\n    enumerate: (G) => {\n      let r = [];\n      for (let i = 0; i < 9; i++) {\n        if (G.cells[i] === null) {\n          r.push({ move: 'clickCell', args: [i] });\n        }\n      }\n      return r;\n    },\n  },\n};\n\nexport default TicTacToe;\n"},"lineCount":null}},"error":null,"hash":"4a882febfcbb8f2e34bc88d0a42c5f55","cacheData":{"env":{}}}