e>\n      <section className=\"content\">\n        {_.flattenDeep(routes.map((route) => route.routes)).map(\n          (route, idx) => (\n            <Route\n              key={idx}\n              exact\n              path={route.path}\n              component={route.component}\n            />\n          )\n        )}\n      </section>\n    </main>\n  </Router>\n);\n"},"lineCount":null}},"error":null,"hash":"09fa79cfa50b46fca2fcfac9230483d7","cacheData":{"env":{}}}