iNavLink from './li-navlink';\n\nimport routes from './routes';\nimport './app.css';\n\n// CSS for the sidebar is taken from vue.css\nexport const App = () => {\n  const isEmbed = window.location.hash.includes('embed=1');\n  return (\n    <Router>\n      <main className={isEmbed ? 'embed' : ''}>\n        {!isEmbed && (\n          <aside className=\"sidebar\">\n            <div className=\"sidebar-nav\" style={{ height: '90%' }}>\n              <ul>\n                {routes.map((route_category, idx) => (\n                  <li key={idx}>\n                    <p>{route_category.name}</p>\n                    <ul>\n                      {route_category.routes.map((route, _idx) => (\n                        <LiNavLink\n                          key={`${idx}.${_idx}`}\n                          to={route.path}\n                          exact={true}\n                          activeClassName=\"active\"\n                        >\n                          {route.text}\n                        </LiNavLink>\n                      ))}\n                    </ul>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </aside>\n        )}\n        <section className=\"content\">\n          {_.flattenDeep(routes.map((route) => route.routes)).map(\n            (route, idx) => (\n              <Route\n                key={idx}\n                exact\n                path={route.path}\n                component={route.component}\n              />\n            )\n          )}\n        </section>\n      </main>\n    </Router>\n  );\n};\n"},"lineCount":null}},"error":null,"hash":"c648a72bc3b65c5a799fb1309abf3aff","cacheData":{"env":{}}}