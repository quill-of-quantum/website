[Unit]
Description=Email Service
After=network-online.target
Wants=network-online.target

[Service]
User=bbdwz
WorkingDirectory=/home/bbdwz/projects/email-service
EnvironmentFile=/home/bbdwz/projects/email-service/.env
ExecStart=/usr/bin/java -jar /home/bbdwz/projects/email-service/target/email-service-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
